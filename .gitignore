# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Git worktrees ─────────────────────────────────────────────────────────────
.worktrees/

# ── Editors / IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.env
.env.*
!.env.example
!monigrid-fe/.env.example

# ── PyInstaller build artifacts ───────────────────────────────────────────────
monigrid-be/build/
monigrid-be/dist/
monigrid-be/build_output.txt
monigrid-be/pyinstaller_build.log
*.spec.bak

# ── pip download cache (오프라인 빌드용 wheel 보관소) ──────────────────────────
# `pip download -d ./packages -r requirements.txt` 산출물. 크기가 크고 환경
# 의존적이며 requirements.txt 가 단일 출처라 git 추적 의미가 없다.
monigrid-be/packages/

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
monigrid-fe/dist/
monigrid-fe/release/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Release packages ──────────────────────────────────────────────────────────
*.zip
*.exe

# ── Logs ─────────────────────────────────────────────────────────────────────
monigrid-be/logs/
*.log

# ── Settings bootstrap (local only; contains DB credentials) ─────────────────
# Ignore every initsetting*.json / *.bak variant, but keep the example template.
monigrid-be/initsetting*.json
monigrid-be/initsetting*.json.bak
!monigrid-be/initsetting.example.json

# ── Seed config / SQL (contains DB credentials before first boot) ────────────
# config.json 은 최초 기동 시 시드되어 .bak 으로 이름이 바뀌지만, 시드 전 단계에서
# DB 자격증명이 들어가므로 git 에는 올라가지 않도록 한다. example/template 만 허용.
monigrid-be/config.json
monigrid-be/config.json.bak
!monigrid-be/config.example.json
monigrid-be/sql.bak/

# ── Local databases / dumps ──────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
# scripts/export_settings_db.py 의 산출물 — 실 DB host / bcrypt hash 포함.
monigrid_db_export*.sql
*.dump.sql

# ── JDBC drivers (binary, license-bound) ─────────────────────────────────────
monigrid-be/drivers/*.jar

# ── Temp ─────────────────────────────────────────────────────────────────────
temp/
tmp/
